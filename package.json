{
  "name": "tally-cc",
  "version": "0.1.0",
  "description": "Per-task receipts and live coaching for Claude Code",
  "type": "module",
  "bin": {
    "tally": "./bin/tally.js"
  },
  "files": [
    "bin",
    "dist",
    "commands",
    "hooks",
    ".claude-plugin",
    "pricing.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "license": "MIT"
}
