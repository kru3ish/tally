+    t.test('a bracket pair inside a bracket group is literal', function (st) {
+        st.deepEqual(qs.parse('search[withbracket[]]=foobar'), { search: { 'withbracket[]': 'foobar' } });
+        st.deepEqual(qs.parse('a[b[]]=c'), { a: { 'b[]': 'c' } });
+        st.deepEqual(qs.parse('a%5Bb%5B%5D%5D=c'), { a: { 'b[]': 'c' } }, 'percent-encoded brackets behave the same');
+        st.deepEqual(qs.parse('x[[]]=1'), { x: { '[]': '1' } }, 'an inner pair may be the whole key');
+        st.deepEqual(qs.parse('a[b[c]]=d'), { a: { 'b[c]': 'd' } }, 'inner pair with content');
+        st.deepEqual(qs.parse('a[b[]][c]=d'), { a: { 'b[]': { c: 'd' } } }, 'literal pair followed by a nested key');
+
+        st.deepEqual(
+            qs.parse('a[b[]]=1&a[b[]]=2'),
+            { a: { 'b[]': ['1', '2'] } },
+            'duplicates combine rather than array-pushing'
+        );
+
+        st.deepEqual(
+            qs.parse(qs.stringify({ search: { 'withbracket[]': 'foobar' } })),
+            { search: { 'withbracket[]': 'foobar' } },
