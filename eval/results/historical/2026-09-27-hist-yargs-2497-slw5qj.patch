+/* global describe, it, afterEach */
 
 import {expect} from 'chai';
 import {applyExtends} from '../helpers/helpers.mjs';
@@ -15,4 +15,45 @@ describe('applyExtends', () => {
     expect(conf.batman).to.equal('Caped Crusader');
     expect(conf.version).to.equal('1.0.2');
   });
+
+  // see: https://github.com/yargs/yargs/issues/2497
+  describe('prototype pollution', () => {
+    afterEach(() => {
+      delete Object.prototype.polluted;
+    });
+
+    it('does not pollute the prototype chain with a "__proto__" key', () => {
+      const conf = applyExtends(
+        JSON.parse('{"__proto__":{"polluted":true},"a":1}'),
+        process.cwd()
+      );
+      expect({}.polluted).to.equal(undefined);
+      expect(conf.polluted).to.equal(undefined);
+      expect(conf.a).to.equal(1);
+    });
+
+    it('does not pollute the prototype chain when merging deeply', () => {
+      const conf = applyExtends(
+        JSON.parse('{"__proto__":{"polluted":true},"a":{"c":2}}'),
+        process.cwd(),
+        true
+      );
+      expect({}.polluted).to.equal(undefined);
+      expect(conf.polluted).to.equal(undefined);
+      expect(conf.a).to.deep.equal({c: 2});
+    });
+
+    it('does not pollute the prototype chain via an extended config', () => {
+      const conf = applyExtends(
+        {extends: './test/fixtures/extends/config_proto.json', a: {c: 2}},
+        process.cwd(),
+        true
+      );
+      expect({}.polluted).to.equal(undefined);
+      expect(conf.polluted).to.equal(undefined);
+      // ordinary keys, including nested objects, still merge:
+      expect(conf.b).to.equal(22);
+      expect(conf.a).to.deep.equal({b: 15, c: 2});
+    });
+  });
 });
