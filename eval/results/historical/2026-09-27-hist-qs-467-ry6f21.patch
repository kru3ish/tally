+    t.test('serializes Date values passed through unchanged by filter=function', function (st) {
+        var date = new Date(1257894000000);
+        var identity = function (prefix, value) {
+            return value;
+        };
+        var obj = { a: date, b: [date], c: { d: date } };
+
+        st.equal(
+            qs.stringify(obj, { filter: identity, encode: false }),
+            'a=2009-11-10T23:00:00.000Z&b[0]=2009-11-10T23:00:00.000Z&c[d]=2009-11-10T23:00:00.000Z',
+            'uses toISOString by default'
+        );
+
+        st.equal(
+            qs.stringify(obj, {
+                filter: identity,
+                encode: false,
+                serializeDate: function (d) { return d.getTime(); }
+            }),
+            'a=1257894000000&b[0]=1257894000000&c[d]=1257894000000',
+            'uses a custom serializeDate'
+        );
+
+        st.equal(
+            qs.stringify(obj, {
+                filter: function (prefix, value) {
+                    return value instanceof Date ? value.getTime() + 1 : value;
+                },
+                encode: false
+            }),
+            'a=1257894000001&b[0]=1257894000001&c[d]=1257894000001',
+            'a filter that transforms a Date still controls the output'
+        );
+
+        st.equal(
+            qs.stringify({ a: [date] }, { filter: identity, encode: false, arrayFormat: 'comma' }),
+            'a=2009-11-10T23:00:00.000Z',
+            'serializes Dates in comma arrays'
+        );
+
+        st.end();
+    });
