diff --git a/test/issue-related.js b/test/issue-related.js
index cd7c131..c39f1c5 100644
--- a/test/issue-related.js
+++ b/test/issue-related.js
@@ -69,4 +69,39 @@ describe('issue-related tests', () => {
     assert(mm.isMatch('a/foo.js', '**/foo.js', { dot: true }));
     assert(mm.isMatch('foo.js', '**/foo.js', { dot: true }));
   });
+
+  it('micromatch issue#212 - brace ranges on paths with dots', () => {
+    assert(mm.isMatch('a.000', 'a.00{0..1}'));
+    assert(mm.isMatch('a.001', 'a.00{0..1}'));
+    assert(!mm.isMatch('a.002', 'a.00{0..1}'));
+    assert(!mm.isMatch('aX000', 'a.00{0..1}'));
+
+    assert(mm.isMatch('a.b.a', 'a.b.{a..c}'));
+    assert(mm.isMatch('a.b.c', 'a.b.{a..c}'));
+    assert(!mm.isMatch('a.b.d', 'a.b.{a..c}'));
+    assert(!mm.isMatch('aXbXc', 'a.b.{a..c}'));
+
+    assert(mm.isMatch('foo/a.7/bar.js', 'foo/a.{1..10}/bar.js'));
+    assert(mm.isMatch('foo/a.10/bar.js', 'foo/a.{1..10}/bar.js'));
+    assert(!mm.isMatch('foo/a.11/bar.js', 'foo/a.{1..10}/bar.js'));
+
+    assert(mm.isMatch('a.03.js', 'a.{01..05}.js'));
+    assert(!mm.isMatch('a.06.js', 'a.{01..05}.js'));
+
+    // ranges must behave the same as the equivalent list, with or without dots
+    assert.deepEqual(mm.makeRe('a.00{0..1}'), mm.makeRe('a.00{0,1}'));
+    assert.deepEqual(mm.makeRe('a00{0..1}'), mm.makeRe('a00{0,1}'));
+    assert.deepEqual(mm.makeRe('**/a.{1..3}/*.js'), mm.makeRe('**/a.{1,2,3}/*.js'));
+
+    // a single-value range collapses to the value
+    assert(mm.isMatch('a.1', 'a.{1..1}'));
+    assert(!mm.isMatch('a.2', 'a.{1..1}'));
+
+    // nested and escaped braces are unaffected
+    assert(mm.isMatch('a.2', 'a.{x,{1..3}}'));
+    assert(mm.isMatch('a.x', 'a.{x,{1..3}}'));
+    assert(!mm.isMatch('a.4', 'a.{x,{1..3}}'));
+    assert(mm.isMatch('a.{0..1}', 'a.\\{0..1}'));
+    assert(!mm.isMatch('a.000', 'a.00{0..1}', { nobrace: true }));
+  });
