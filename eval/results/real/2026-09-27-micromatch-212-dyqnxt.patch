+/**
+ * picomatch <= 3 generates a corrupt regex source for brace ranges. Closing a
+ * range makes picomatch rebuild its output from the token list, and its token
+ * list has lost the escaped output of the text run in front of the range, so
+ * `a.00{0..1}` compiles to `/^(?:.00[0-1])$/` instead of `/^(?:a\.00[0-1])$/`.
+ * Brace lists are compiled without that rebuild, so rewriting `{0..1}` as
+ * `{0,1}` gives the regex the range form was supposed to produce.
+ *
+ * See https://github.com/micromatch/micromatch/issues/212
+ */
+
+const RANGE_BODY_REGEX = /^(-?\d+|[a-zA-Z])\.\.(-?\d+|[a-zA-Z])(?:\.\.-?\d+)?$/;
+const UNSAFE_LIST_VALUE_REGEX = /[\\(){},|]/;
+
+const rangeToList = body => {
+  if (!RANGE_BODY_REGEX.test(body)) return null;
+
+  let values;
+  try {
+    values = braces.expand(`{${body}}`);
+  } catch (err) {
+    // The range is larger than braces' rangeLimit, so there is no list form.
+    return null;
+  }
+
+  if (values.some(v => UNSAFE_LIST_VALUE_REGEX.test(v))) {
+    return null;
+  }
+
+  // a single-value list would be compiled as a literal brace by picomatch
+  return values.length === 1 ? values[0] : `{${values.join(',')}}`;
+};
+
+const convertRanges = (input, index, depth) => {
+  let output = '';
+  let i = index;
+
+  while (i < input.length) {
+    const value = input[i];
+
+    if (value === '\\') {
+      output += input.slice(i, i + 2);
+      i += 2;
+      continue;
+    }
+
+    if (value === '{') {
+      const [inner, next] = convertRanges(input, i + 1, depth + 1);
+
+      if (input[next] === '}') {
+        output += rangeToList(inner) || `{${inner}}`;
+        i = next + 1;
+      } else {
+        output += `{${inner}`;
+        i = next;
+      }
+      continue;
+    }
+
+    if (value === '}' && depth > 0) {
+      return [output, i];
+    }
+
+    output += value;
+    i++;
+  }
+
+  return [output, i];
+};
+
+const expandRanges = (pattern, options) => {
+  if (typeof pattern !== 'string' || !pattern.includes('..') || !hasBraces(pattern)) {
+    return pattern;
+  }
+
+  if (options && options.nobrace === true) {
+    return pattern;
+  }
+
+  return convertRanges(pattern, 0, 0)[0];
+};
+
+const expandPatternRanges = (patterns, options) => {
+  if (Array.isArray(patterns)) {
+    return patterns.map(pattern => expandRanges(pattern, options));
+  }
+  return expandRanges(patterns, options);
+};
