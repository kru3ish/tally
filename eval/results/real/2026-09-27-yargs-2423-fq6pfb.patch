+  // Addresses: https://github.com/yargs/yargs/issues/2423
+  describe('halt-at-non-option', () => {
+    const sshLike = (args, opts = {}) =>
+      yargs(args)
+        .usage('$0 <host> [<cmd>...]', 'Run command via ssh', yargs =>
+          yargs
+            .positional('host', {type: 'string', demandOption: true})
+            .positional('cmd', {array: true, type: 'string'})
+            .options({
+              verbose: {type: 'boolean', alias: 'v', count: true},
+            })
+        )
+        .strict()
+        .parserConfiguration({'halt-at-non-option': true, ...opts})
+        .parseSync();
+
+    it('populates positionals of a default command', () => {
+      const argv = sshLike(['my-host', 'ls']);
+      argv.host.should.equal('my-host');
+      argv.cmd.should.eql(['ls']);
+      argv._.should.eql([]);
+    });
+
+    it('parses options preceding the first positional', () => {
+      const argv = sshLike(['--verbose', '-v', 'my-host', 'ls']);
+      argv.verbose.should.equal(2);
+      argv.host.should.equal('my-host');
+      argv.cmd.should.eql(['ls']);
+    });
+
+    it('halts on the first positional, leaving later arguments untouched', () => {
+      const argv = sshLike(['my-host', 'ls', '-l', '--verbose', '/tmp']);
+      argv.verbose.should.equal(0);
+      argv.host.should.equal('my-host');
+      argv.cmd.should.eql(['ls', '-l', '--verbose', '/tmp']);
+    });
+
+    it('populates positionals of a named command', done => {
+      yargs(['run', 'my-host', 'ls', '-l'])
+        .command('run <host> [cmd...]', 'run a command', noop, argv => {
+          argv.host.should.equal('my-host');
+          argv.cmd.should.eql(['ls', '-l']);
+          argv._.should.eql(['run']);
+          return done();
+        })
+        .strict()
+        .parserConfiguration({'halt-at-non-option': true})
+        .parse();
+    });
+
+    it("does not populate '--' for the halted arguments", () => {
+      const argv = sshLike(['my-host', 'ls']);
+      expect(argv['--']).to.equal(undefined);
+    });
+
+    it("leaves '--' handling untouched when disabled", done => {
+      yargs(['run', 'my-host', '--', 'ls', '-l'])
+        .command('run <host> [cmd...]', 'run a command', noop, argv => {
+          argv.host.should.equal('my-host');
+          argv.cmd.should.eql([]);
+          argv['--'].should.eql(['ls', '-l']);
+          return done();
+        })
+        .strict()
+        .parserConfiguration({
+          'halt-at-non-option': false,
+          'populate--': true,
+        })
+        .parse();
+    });
+  });
