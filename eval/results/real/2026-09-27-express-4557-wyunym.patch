+/**
+ * Compile a mount path into a path the router matches literally.
+ *
+ * A path made up only of slashes ("//", "///") is trimmed down to the
+ * empty string by the router, which then matches every request. Such a
+ * path is turned into an expression that only matches the slashes given.
+ *
+ * @param {String|RegExp|Array} path
+ * @return {String|RegExp|Array}
+ * @api private
+ */
+
+exports.compileMountPath = function compileMountPath(path) {
+  if (Array.isArray(path)) {
+    return path.map(function (p) { return exports.compileMountPath(p) });
+  }
+
+  if (typeof path !== 'string' || !SLASHES_ONLY_REGEXP.test(path)) {
+    return path;
+  }
+
+  return new RegExp('^' + path.replace(/\//g, '\\/') + '(?=\\/|$)');
+};
